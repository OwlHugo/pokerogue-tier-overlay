{
  "name": "pokerogue-tier-overlay",
  "version": "2.0.0",
  "description": "Marca o melhor tier competitivo do Smogon da linha evolutiva de cada Pokemon no PokeRogue",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:tiers": "tsx tools/build-tier-table.mts",
    "launch": "tsx tools/dev-launch.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:bookmarklet": "tsx tools/build-bookmarklet.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@pkmn/dex": "^0.9.36",
    "@types/node": "^24.0.0",
    "puppeteer": "^24.10.0",
    "terser": "^5.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
